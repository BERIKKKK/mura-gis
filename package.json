{
  "name": "mura-gis",
  "productName": "Mura GIS",
  "version": "2.1.2",
  "description": "Mura GIS — тарихи-мәдени мұра объектілеріне арналған ГАЖ бағдарламасы: ескерткіштерді белгілеу, тізімдер, қорғау аймақтарын есептеу",
  "main": "main/main.js",
  "author": "BERIKKKK",
  "homepage": "https://github.com/BERIKKKK/mura-gis",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "icon": "electron scripts/make-icon.js",
    "start": "electron .",
    "dist:win": "node scripts/build-win.js --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "release:win": "node scripts/build-win.js --win --publish always",
    "release:linux": "electron-builder --linux --publish always",
    "test": "node scripts/test-graph.mjs && node scripts/test-periods.mjs && node scripts/test-plan.mjs && node scripts/test-sync.mjs",
    "smoke": "electron scripts/smoke.js",
    "smoke:marks": "electron scripts/smoke-marks.js",
    "smoke:routes": "electron scripts/smoke-routes.js",
    "smoke:save": "electron scripts/smoke-save.js",
    "smoke:ru": "electron scripts/smoke-ru.js",
    "smoke:plan": "electron scripts/smoke-plan.js",
    "smoke:sync": "electron scripts/smoke-sync.js",
    "smoke:perf": "electron scripts/smoke-perf.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "leaflet": "1.9.4"
  },
  "build": {
    "appId": "io.github.berikkkk.muragis",
    "productName": "Mura GIS",
    "copyright": "© BERIKKKK",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "src/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "BERIKKKK",
        "repo": "mura-gis",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mura GIS",
      "artifactName": "MuraGIS-Setup-${version}.${ext}",
      "installerLanguages": [
        "kk_KZ",
        "ru_RU"
      ],
      "language": "1087",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "MuraGIS-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "icon": "build/icon.png",
      "artifactName": "MuraGIS-${version}-${arch}.${ext}"
    }
  }
}
