{
  "$comment": "НИПД: ескерткіш аумақтарының GeoJSON құрылымы — пайдаланушы берген үлгі бойынша («экспорт arm monuments Aktobe mestnyi 2 qaztrf»). Әр нысан — бір ескерткіштің аумағы (Polygon), 8 атрибут. source — дереккөз: mark.* (ескерткіш белгісі), zone.* (қорғау аймағы жазбасы), common.* (бір рет енгізілетін ортақ мәндер), override.* (пайдаланушы түзеткені), computed.* (плагин анықтағаны). valueMap — Mura GIS кодтарын НИПД мәндеріне айналдыру. type үшін тек «Археологический» мәні үлгіде расталған; қалғандары — болжам, НИПД анықтамалығымен тексеріңіз.",
  "name": "НИПД — территории памятников",
  "version": "1",
  "lang": "ru",
  "crs": "EPSG:4326",
  "crsName": "urn:ogc:def:crs:EPSG::10941",
  "$crsComment": "EPSG:10941 — QazTRF-23 (геодезиялық, GRS 1980, ITRF негізінде). Mura GIS координаттары WGS 84; екеуінің айырмасы сантиметр деңгейінде, сондықтан градустар түрлендірусіз жазылып, crs белгісі QazTRF-23 болып қойылады.",
  "collectionName": "экспорт arm monuments",
  "fields": [
    { "name": "name", "type": "string", "required": true, "maxLength": 500, "source": ["mark.name", "zone.name"] },
    { "name": "category_level", "type": "string", "required": true, "source": ["mark.category"],
      "valueMap": { "intl": "Международного значения", "rep": "Республиканского значения", "local": "Местного значения" },
      "enum": ["Международного значения", "Республиканского значения", "Местного значения"] },
    { "name": "type", "type": "string", "required": true, "source": ["mark.type", "zone.type"],
      "valueMap": { "archeo": "Археологический", "arch": "Градостроительства и архитектуры", "ensemble": "Ансамбли и комплексы", "sacred": "Сакральный", "art": "Монументального искусства" },
      "enum": ["Археологический", "Градостроительства и архитектуры", "Ансамбли и комплексы", "Сакральный", "Монументального искусства"] },
    { "name": "monument_kind", "type": "string", "required": true, "maxLength": 100, "source": ["override.monument_kind", "computed.monument_kind"], "editable": true,
      "label": { "kk": "Ескерткіш түрі (Могильник, Курган…)", "ru": "Вид памятника (Могильник, Курган…)" } },
    { "name": "inclusion_date", "type": "datetime", "required": true, "source": ["common.inclusion_date"], "common": true,
      "label": { "kk": "Тізімге енгізілген күні (ЖЖЖЖ-АА-КК)", "ru": "Дата включения в список (ГГГГ-ММ-ДД)" } },
    { "name": "included_by_authority", "type": "string", "required": true, "maxLength": 300, "source": ["common.included_by_authority"], "common": true,
      "label": { "kk": "Тізімге енгізген орган", "ru": "Кем включён в список" }, "default": "" },
    { "name": "responsible_organization", "type": "string", "required": true, "maxLength": 300, "source": ["common.responsible_organization"], "common": true,
      "label": { "kk": "Жауапты ұйым", "ru": "Ответственная организация" } },
    { "name": "website_link", "type": "string", "required": false, "maxLength": 500, "pattern": "^https?://", "source": ["common.website_link"], "common": true,
      "label": { "kk": "Құжатқа сілтеме (қаулы)", "ru": "Ссылка на документ (постановление)" } }
  ],
  "kinds": [
    { "value": "Могильник", "match": ["могильник", "қорым", "корым"] },
    { "value": "Курган", "match": ["курган", "қорған", "корган"] },
    { "value": "Поселение", "match": ["поселени", "қоныс", "коныс"] },
    { "value": "Городище", "match": ["городищ", "қалашық", "калашык"] },
    { "value": "Стоянка", "match": ["стоянк", "тұрақ"] },
    { "value": "Некрополь", "match": ["некропол"] },
    { "value": "Мавзолей", "match": ["мавзоле", "кесене"] },
    { "value": "Петроглифы", "match": ["петроглиф", "наскальн", "таңбалы"] },
    { "value": "Святилище", "match": ["святилищ", "ғибадатхана"] },
    { "value": "Мечеть", "match": ["мечет", "мешіт"] },
    { "value": "Крепость", "match": ["крепост", "бекініс"] }
  ]
}
