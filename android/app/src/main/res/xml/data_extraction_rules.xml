<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mura.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="mura_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mura.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="mura_sync.xml" />
        <include domain="file" path="maps/" />
    </device-transfer>
</data-extraction-rules>
