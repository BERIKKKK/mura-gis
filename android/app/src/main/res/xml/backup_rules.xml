<?xml version="1.0" encoding="utf-8"?>
<!-- Android сақтық көшірмесі: дерекқор (ескерткіштер, маршруттар) — иә; карта файлдары (үлкен) — жоқ.
     include бар болғандықтан тек аталған жолдар сақталады: files/ (maps/, exports/) өздігінен шығып қалады. -->
<full-backup-content>
    <include domain="database" path="mura.db" />
    <include domain="sharedpref" path="." />
    <!-- Синхрондау баптаулары (құрылғы id-і, аккаунт) көшірілмейді: екі телефонда бір id болса, нұсқалар шатасады -->
    <exclude domain="sharedpref" path="mura_sync.xml" />
</full-backup-content>
